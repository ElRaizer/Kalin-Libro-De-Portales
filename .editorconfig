root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.gd]
indent_style = tab
max_line_length = 100

[*.{md,godot,tscn,tres}]
indent_style = space
indent_size = 2

[*.{py,ps1}]
indent_style = space
indent_size = 4

[*.{json,yml,yaml}]
indent_style = space
indent_size = 2
