[sub_resource type="Resource" id="Beat_1"]
script = ExtResource("2_beat")
speaker = "Narrador"
text = "Kalin salió del portal en medio de un huracán. Abrazó su libro para protegerlo."
background = ExtResource("3_bg_huracan")
kalin_motion = 6
effects = 3
screen_shake = true
flash = true
title = "Prólogo"
subtitle = "La noche del huracán"
auto_advance = 1.8

[sub_resource type="Resource" id="Beat_2"]
script = ExtResource("2_beat")
speaker = "Narrador"
text = "Una ráfaga arrancó las páginas. Kalin intentó sujetarlas, pero el viento las dispersó y apagó sus palabras."
kalin_motion = 6
page_motion = 1
effects = 11
flash = true
auto_advance = 1.8

[sub_resource type="Resource" id="Beat_3"]
script = ExtResource("2_beat")
speaker = "Narrador"
text = "El sendero de luz se borró del libro. El portal se cerró y la tormenta rompió los caminos de la isla."
kalin_motion = 6
effects = 3
screen_shake = true
auto_advance = 1.8

[sub_resource type="Resource" id="Beat_4"]
script = ExtResource("2_beat")
speaker = "Narrador"
text = "Al amanecer, Kalin descansó en la orilla con la cubierta del libro entre las manos."
background = ExtResource("4_bg_isla")
mood = 5
effects = 16
kalin_motion = 4
auto_advance = 2.2

[sub_resource type="Resource" id="Beat_5"]
script = ExtResource("2_beat")
speaker = "Narrador"
text = "Unas huellas llegaban hasta las casas. Quizá allí alguien pudiera ayudarlo a volver."
kalin_pose = 1
mood = 1
effects = 16
auto_advance = 1.6

