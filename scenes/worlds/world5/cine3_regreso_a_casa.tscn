[sub_resource type="Resource" id="Beat_1"]
script = ExtResource("2_beat")
speaker = "Narrador"
text = "Kalin sostuvo el libro contra el pecho. Miró una vez más a sus amigos antes de dar el primer paso."
background = ExtResource("3_bg_portal_isla")
kalin_motion = 8
actors = Array[String](["Peek'", "Miis", "Kaax", "Áak"])
effects = 0
auto_advance = 1.8

[sub_resource type="Resource" id="Beat_2"]
script = ExtResource("2_beat")
speaker = "Narrador"
text = "Dio un paso, luego otro... y el portal lo envolvió en una luz dorada."
actors = Array[String](["Peek'", "Miis", "Kaax", "Áak"])
effects = 0
kalin_motion = 5
auto_advance = 2.2

[sub_resource type="Resource" id="Beat_3"]
script = ExtResource("2_beat")
speaker = "Narrador"
text = "Kalin cerró el libro sobre las páginas recuperadas. Sus palabras conservaron la luz durante el cruce."
background = ExtResource("4_bg_portal")
kalin_pose = 2
effects = 0
screen_shake = false
flash = false
auto_advance = 1.8

[sub_resource type="Resource" id="Beat_4"]
script = ExtResource("2_beat")
speaker = "Narrador"
text = "El portal dejó a Kalin en su cuarto. Al abrir el libro, encontró el recuerdo que había elegido en la aldea."
background = ExtResource("5_bg_cuarto")
effects = 0
kalin_motion = 0
auto_advance = 2.2

[sub_resource type="Resource" id="Beat_5"]
script = ExtResource("2_beat")
speaker = "Kalin"
text = "¡Nuestro recuerdo sigue aquí! Cada palabra me lleva a algo que vivimos juntos. Tak ti' uláak' k'iin, amigos."
kalin_pose = 1
kalin_motion = 6
gesture_texture = ExtResource("hold_book")
effects = 0

[sub_resource type="Resource" id="Beat_6"]
script = ExtResource("2_beat")
speaker = "Narrador"
text = "Kalin cerró el libro con cuidado. Los caminos quedaban lejos; sus amigos seguían cerca en cada palabra."
effects = 0
kalin_motion = 0
title = "Fin"
subtitle = "Tak ti' uláak' k'iin"

