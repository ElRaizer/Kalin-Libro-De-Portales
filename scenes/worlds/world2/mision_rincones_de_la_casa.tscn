quality = ""
success = "¡Aquí nos sentaremos juntos! Guardaré un sitio para ti."

[sub_resource type="Resource" id="task_1"]
script = ExtResource("task")
requester = "Miis"
request = "Después de explorar me gusta descansar. Necesito una hamaca."
