request = "Ya están todos reunidos. Necesito comida para compartir."
item = "janal"
quality = ""
success = "¡La merienda está lista! Tú también eres parte de la aldea."

[node name="Mision_RinconesDeLaCasa" instance=ExtResource("base")]
mission_kind = "home"
chapter_title = "Rincones para compartir"
