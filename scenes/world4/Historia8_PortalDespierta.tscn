actors = Array[String](["Kaax", "Kéej", "Peek'", "Miis"])
effects = 24

[sub_resource type="Resource" id="Beat_7"]
script = ExtResource("2_beat")
speaker = "Peek'"
text = "Nosotros te las enseñamos. Por la mañana, para saludar, decimos Bix a beel."
