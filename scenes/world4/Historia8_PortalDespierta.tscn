[sub_resource type="Resource" id="Beat_2"]
script = ExtResource("2_beat")
kind = 3
speaker = "Áak"
text = "¿Recuerdas lo que pidió Miis? «Quiero un plátano pequeño»: In k'a'at ja'as ___"
