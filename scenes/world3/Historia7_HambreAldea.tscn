[sub_resource type="Resource" id="Beat_7"]
script = ExtResource("2_beat")
speaker = "K'éek'en"
text = "Cuando queremos algo, decimos In k'a'at. Significa «yo quiero»."
actors = Array[String](["K'éek'en", "Kéej", "Peek'", "Miis"])

[sub_resource type="Resource" id="Beat_8"]
script = ExtResource("2_beat")
kind = 3
speaker = "Peek'"
text = "Tengo mucha sed. ¿Cuál de estas palabras crees que es «agua»?"
actors = Array[String](["K'éek'en", "Kéej", "Peek'", "Miis"])
target_word = "ja'"
options = Array[String](["janal", "ja'", "ja'as"])

[sub_resource type="Resource" id="Beat_9"]
script = ExtResource("2_beat")
speaker = "Kéej"
text = "¡Y yo quiero plátano! Pero ten cuidado: ja' y ja'as suenan muy parecido."
actors = Array[String](["K'éek'en", "Kéej", "Peek'", "Miis"])

[sub_resource type="Resource" id="Beat_10"]
script = ExtResource("2_beat")
speaker = "Kalin"
text = "¡Les serviré todo lo que pidan! Escucharé con atención cada In k'a'at."
actors = Array[String](["K'éek'en", "Kéej", "Peek'", "Miis"])

