[sub_resource type="Resource" id="Beat_1"]
script = ExtResource("2_beat")
speaker = "Peek'"
text = "¡Gracias, Kalin! Gracias a tus caminos ya estamos en casa."
background = ExtResource("3_bg_isla")
actors = Array[String](["Peek'", "Miis", "Kaax"])

[sub_resource type="Resource" id="Beat_2"]
script = ExtResource("2_beat")
kind = 2
speaker = "Miis"
text = "Kaax quiere darte las gracias, pero se escondió entre nosotros. ¿Quién es Kaax?"
actors = Array[String](["Peek'", "Miis", "Kaax"])
target_word = "Kaax"

[sub_resource type="Resource" id="Beat_3"]
script = ExtResource("2_beat")
speaker = "Kalin"
text = "¡Miren, mi libro brilla! Las palabras de mis amigos volvieron a sus páginas."
kalin_pose = 1
actors = Array[String](["Peek'", "Miis", "Kaax"])
celebrate_page = true

[sub_resource type="Resource" id="Beat_4"]
script = ExtResource("2_beat")
speaker = "Narrador"
text = "Kalin siguió el sendero hasta el bosque. Allí lo esperaban tres animales más."
background = ExtResource("4_bg_monte")
actors = Array[String](["Kéej", "K'éek'en", "Ma'ax"])
kalin_motion = 1

[sub_resource type="Resource" id="Beat_5"]
script = ExtResource("2_beat")
kind = 1
speaker = "Narrador"
text = "Ellos también perdieron su camino. Toca a cada uno para escuchar su nombre."
actors = Array[String](["Kéej", "K'éek'en", "Ma'ax"])

[sub_resource type="Resource" id="Beat_6"]
script = ExtResource("2_beat")
speaker = "Ma'ax"
text = "¡Cuidado! En el bosque los caminos no pueden cruzarse. Piensa bien por dónde pasa cada uno."
actors = Array[String](["Kéej", "K'éek'en", "Ma'ax"])

[node name="Historia2" instance=ExtResource("1_base")]
