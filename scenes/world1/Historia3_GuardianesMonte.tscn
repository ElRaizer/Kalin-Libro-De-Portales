[sub_resource type="Resource" id="Beat_5"]
script = ExtResource("2_beat")
kind = 1
speaker = "Narrador"
text = "Los guardianes cuidan el monte. Toca a cada uno para conocerlo."
actors = Array[String](["Báalam", "Kuuts", "T'u'ul"])

[sub_resource type="Resource" id="Beat_6"]
script = ExtResource("2_beat")
speaker = "Báalam"
text = "La niebla esconde las rocas del monte. Míralas bien antes de que desaparezcan: seguirán ahí aunque no las veas."
actors = Array[String](["Báalam", "Kuuts", "T'u'ul"])

