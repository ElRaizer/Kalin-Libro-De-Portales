target_word = "Ma'ax"

[sub_resource type="Resource" id="Beat_3"]
script = ExtResource("2_beat")
speaker = "Kalin"
text = "¡Otra página recuperada! Mi libro ya se siente más pesado."
actors = Array[String](["Kéej", "K'éek'en", "Ma'ax"])
celebrate_page = true

[sub_resource type="Resource" id="Beat_4"]
script = ExtResource("2_beat")
speaker = "Narrador"
text = "En lo alto del monte, entre la niebla, aparecieron los guardianes."
kalin_pose = 1
actors = Array[String](["Báalam", "Kuuts", "T'u'ul"])
