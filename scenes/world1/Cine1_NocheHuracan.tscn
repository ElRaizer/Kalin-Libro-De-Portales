[sub_resource type="Resource" id="Beat_1"]
script = ExtResource("2_beat")
speaker = "Narrador"
text = "Esa noche, mientras Kalin caía por el portal, un huracán cruzó la isla de los animales."
background = ExtResource("3_bg_huracan")
kalin_pose = 2
effects = 3
screen_shake = true
flash = true
title = "Prólogo"
subtitle = "La noche del huracán"
auto_advance = 1.8

[sub_resource type="Resource" id="Beat_2"]
script = ExtResource("2_beat")
speaker = "Narrador"
text = "Las páginas de su libro se soltaron y cayeron entre la lluvia como estrellas de papel."
kalin_pose = 2
effects = 11
flash = true
auto_advance = 1.8

[sub_resource type="Resource" id="Beat_3"]
script = ExtResource("2_beat")
speaker = "Narrador"
text = "El viento arrancó las hojas, levantó las olas y borró los Caminos Blancos, el Sak Beh."
kalin_pose = 2
effects = 3
screen_shake = true
auto_advance = 1.8

[sub_resource type="Resource" id="Beat_4"]
script = ExtResource("2_beat")
speaker = "Narrador"
text = "Al amanecer, la tormenta se fue. En la orilla, un joven aprendiz de hechicero dormía profundamente."
background = ExtResource("4_bg_isla")
mood = 5
effects = 16
kalin_motion = 4
auto_advance = 2.2

[sub_resource type="Resource" id="Beat_5"]
script = ExtResource("2_beat")
speaker = "Narrador"
text = "Kalin abrió los ojos. Su aventura en la isla estaba a punto de comenzar."
kalin_pose = 1
mood = 1
effects = 16
auto_advance = 1.6

