target_word = "Báalam"

[sub_resource type="Resource" id="Beat_3"]
script = ExtResource("2_beat")
speaker = "Kalin"
text = "¡Una página más! Ya casi tengo a todos los animales de la isla."
actors = Array[String](["Báalam", "Kuuts", "T'u'ul"])
celebrate_page = true

[sub_resource type="Resource" id="Beat_4"]
script = ExtResource("2_beat")
speaker = "Narrador"
text = "Kalin bajó hasta la orilla. Un pez, un pájaro y una tortuga lo llamaban desde el agua y el cielo."
