[sub_resource type="Resource" id="Beat_5"]
script = ExtResource("2_beat")
kind = 1
speaker = "Narrador"
text = "Toca a cada uno para saludarlo."
actors = Array[String](["Kay", "Ch'íich'", "Áak"])

[sub_resource type="Resource" id="Beat_6"]
script = ExtResource("2_beat")
speaker = "Áak"
text = "Las olas se llevaron las señales de nuestras casas. Obsérvalas bien, porque después solo verás signos de pregunta."
actors = Array[String](["Kay", "Ch'íich'", "Áak"])

