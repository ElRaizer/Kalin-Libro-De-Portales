[sub_resource type="Resource" id="Beat_1"]
script = ExtResource("2_beat")
speaker = "Kalin"
text = "Mi Libro de Hechizos tiene todas sus páginas en blanco... ¿Alguien aquí podrá ayudarme?"
background = ExtResource("3_bg_isla")
kalin_pose = 1
actors = Array[String]([])

[sub_resource type="Resource" id="Beat_2"]
script = ExtResource("2_beat")
speaker = "Narrador"
text = "Tres animales se acercaron con curiosidad: uno movía la cola, otro las orejas y otro las plumas."
kalin_pose = 1
actors = Array[String](["Peek'", "Miis", "Kaax"])

[sub_resource type="Resource" id="Beat_3"]
script = ExtResource("2_beat")
kind = 1
speaker = "Narrador"
text = "En esta isla los animales se presentan diciendo In k'aaba'e', que significa «me llamo». Toca a cada uno para saludarlo."
actors = Array[String](["Peek'", "Miis", "Kaax"])

[sub_resource type="Resource" id="Beat_4"]
script = ExtResource("2_beat")
speaker = "Peek'"
text = "¡Hola, Kalin! Anoche pasó un huracán y borró los Caminos Blancos, el Sak Beh. Ya no sabemos volver a casa."
actors = Array[String](["Peek'", "Miis", "Kaax"])

[sub_resource type="Resource" id="Beat_5"]
script = ExtResource("2_beat")
speaker = "Kalin"
text = "¡Yo los ayudo! Con mi magia puedo trazar caminos nuevos... y quizá mis palabras regresen al libro."
actors = Array[String](["Peek'", "Miis", "Kaax"])

[sub_resource type="Resource" id="Beat_6"]
script = ExtResource("2_beat")
kind = 2
speaker = "Peek'"
text = "Antes de irnos, un juego: ¿quién de nosotros es Miis?"
actors = Array[String](["Peek'", "Miis", "Kaax"])
target_word = "Miis"

[sub_resource type="Resource" id="Beat_7"]
script = ExtResource("2_beat")
speaker = "Kaax"
text = "¡Así se hace! Ahora traza un camino desde cada uno de nosotros hasta su casa."
actors = Array[String](["Peek'", "Miis", "Kaax"])

[node name="Historia1" instance=ExtResource("1_base")]
chapter_title = "Mundo 1 · Capítulo 1 — La isla de los animales"
